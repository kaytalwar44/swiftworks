# =============================================================================
# SwiftWorks — environment template
#
# Copy to .env.local and fill in. .env.local is gitignored and must never be
# committed.
#
# Only variables prefixed with VITE_ reach the browser. Anything without that
# prefix is server-side only and invisible to this SPA.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — required
# -----------------------------------------------------------------------------
# Project Settings -> API in the Supabase dashboard.
VITE_SUPABASE_URL=[your-project-ref.supabase.co](https://your-project-ref.supabase.co)

# The "anon" / publishable key. This is public by design: it identifies the
# project, not the user. Row Level Security is what protects the data — the
# Phase 4 policies gate every table on app.current_company_id().
#
# NEVER put the service_role key here. It bypasses RLS entirely and would
# expose every tenant's data to anyone who opens devtools.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# Application — required
# -----------------------------------------------------------------------------
# Public origin. Used to build QR booking links and auth redirect URLs, so it
# must match an allowed redirect in Supabase Auth -> URL Configuration.
VITE_APP_URL=[localhost](http://localhost:5173)

# development | staging | production
VITE_APP_ENV=development
